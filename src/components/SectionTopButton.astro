---
interface Props {
  label: string;
}
const { label } = Astro.props;
---
<button class="section-top-button" type="button" title={label} aria-label={label}>
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M6 11l6-6 6 6"></path></svg>
</button>
