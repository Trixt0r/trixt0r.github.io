---
import type { Labels } from "../lib/types";

interface Props {
  labels: Labels;
}

const { labels } = Astro.props;
---

<div class="theme-toggle-group" role="group" aria-label={labels.themeLabel}>
  <button class="control-group__item control-group__item--icon" type="button" data-theme-value="light" aria-pressed="false" aria-label={labels.lightTheme} title={labels.lightTheme}>
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path></svg>
  </button>
  <button class="control-group__item control-group__item--icon" type="button" data-theme-value="dark" aria-pressed="false" aria-label={labels.darkTheme} title={labels.darkTheme}>
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"></path></svg>
  </button>
</div>

<script>
  const STORAGE_KEY = "preferred-theme";
  const root = document.documentElement;
  const themeButtons = document.querySelectorAll("[data-theme-value]");

  function resolveTheme(value) {
    if (value === "light" || value === "dark") {
      return value;
    }

    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  }

  function applyTheme(value) {
    root.setAttribute("data-theme", value);
  }

  function updateButtons(theme) {
    for (const button of themeButtons) {
      if (!(button instanceof HTMLButtonElement)) {
        continue;
      }

      const isActive = button.dataset.themeValue === theme;
      button.classList.toggle("is-active", isActive);
      button.setAttribute("aria-pressed", isActive ? "true" : "false");
    }
  }

  let savedTheme: string | null = null;
  try { savedTheme = localStorage.getItem(STORAGE_KEY); } catch {}
  const activeTheme = resolveTheme(savedTheme);
  applyTheme(activeTheme);
  updateButtons(activeTheme);

  for (const button of themeButtons) {
    button.addEventListener("click", () => {
      if (!(button instanceof HTMLButtonElement)) {
        return;
      }

      const nextTheme = button.dataset.themeValue;
      if (!nextTheme) {
        return;
      }

      try { localStorage.setItem(STORAGE_KEY, nextTheme); } catch {}
      savedTheme = nextTheme;
      applyTheme(nextTheme);
      updateButtons(nextTheme);
    });
  }

  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
    if (savedTheme !== "light" && savedTheme !== "dark") {
      const theme = resolveTheme(null);
      applyTheme(theme);
      updateButtons(theme);
    }
  });
</script>
