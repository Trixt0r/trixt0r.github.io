---
import {
  siAndroid,
  siAngular,
  siApachecordova,
  siApple,
  siAurelia,
  siBackbonedotjs,
  siCentos,
  siClaude,
  siClaudecode,
  siDocker,
  siDotnet,
  siExpress,
  siGooglegemini,
  siJavascript,
  siKubernetes,
  siMariadb,
  siNestjs,
  siNodedotjs,
  siNx,
  siOpencode,
  siPhp,
  siPostgresql,
  siStorybook,
  siTerraform,
  siTypescript,
  siVuedotjs,
  siZend,
} from "simple-icons";
import { icons as deviconIcons } from "@iconify-json/devicon-plain";

interface Props {
  label: string;
  iconOnly?: boolean;
}

const { label, iconOnly = false } = Astro.props;

// Devicon's plain Java mark; rendered with currentColor like the Simple Icons marks.
const javaIcon = {
  path: "M47.617 98.12c-19.192 5.362 11.677 16.439 36.115 5.969-4.003-1.556-6.874-3.351-6.874-3.351-10.897 2.06-15.952 2.222-25.844 1.092-8.164-.935-3.397-3.71-3.397-3.71zm33.189-10.46c-14.444 2.779-22.787 2.69-33.354 1.6-8.171-.845-2.822-4.805-2.822-4.805-21.137 7.016 11.767 14.977 41.309 6.336-3.14-1.106-5.133-3.131-5.133-3.131zm11.319-60.575s-42.731 10.669-22.323 34.187c6.024 6.935-1.58 13.17-1.58 13.17s15.289-7.891 8.269-17.777c-6.559-9.215-11.587-13.793 15.634-29.58zm9.998 81.144s3.529 2.91-3.888 5.159c-14.102 4.272-58.706 5.56-71.095.171-4.45-1.938 3.899-4.625 6.526-5.192 2.739-.593 4.303-.485 4.303-.485-4.952-3.487-32.013 6.85-13.742 9.815 49.821 8.076 90.817-3.637 77.896-9.468zM85 77.896c2.395-1.634 5.703-3.053 5.703-3.053s-9.424 1.685-18.813 2.474c-11.494.964-23.823 1.154-30.012.326-14.652-1.959 8.033-7.348 8.033-7.348s-8.812-.596-19.644 4.644C17.455 81.134 61.958 83.958 85 77.896zm5.609 15.145c-.108.29-.468.616-.468.616 31.273-8.221 19.775-28.979 4.822-23.725-1.312.464-2 1.543-2 1.543s.829-.334 2.678-.72c7.559-1.575 18.389 10.119-5.032 22.286zM64.181 70.069c-4.614-10.429-20.26-19.553.007-35.559C89.459 14.563 76.492 1.587 76.492 1.587c5.23 20.608-18.451 26.833-26.999 39.667-5.821 8.745 2.857 18.142 14.688 28.815zm27.274 51.748c-19.187 3.612-42.854 3.191-56.887.874 0 0 2.874 2.38 17.646 3.331 22.476 1.437 57-.8 57.816-11.436.001 0-1.57 4.032-18.575 7.231z",
};

const icons = {
  ".NET": siDotnet,
  "ASP.NET": siDotnet,
  "C#": siDotnet,
  Android: siAndroid,
  Angular: siAngular,
  "Apache Cordova": siApachecordova,
  Aurelia: siAurelia,
  "Backbone.js": siBackbonedotjs,
  CentOS: siCentos,
  "Claude Code": siClaudecode,
  Claude: siClaude,
  Cordova: siApachecordova,
  Docker: siDocker,
  Express: siExpress,
  Gemini: siGooglegemini,
  iOS: siApple,
  Java: javaIcon,
  JavaScript: siJavascript,
  Kubernetes: siKubernetes,
  MariaDB: siMariadb,
  NestJS: siNestjs,
  "Node.js": siNodedotjs,
  Nx: siNx,
  OpenCode: siOpencode,
  PHP: siPhp,
  PostgreSQL: siPostgresql,
  "SQL Server": deviconIcons.icons.microsoftsqlserver,
  Storybook: siStorybook,
  Terraform: siTerraform,
  TypeScript: siTypescript,
  Vue: siVuedotjs,
  "Zend Framework": siZend,
} as const;

const icon = icons[label as keyof typeof icons];
const iconViewBox = label === "Java" || label === "SQL Server" ? "0 0 128 128" : "0 0 24 24";
const cloudLabels = new Set(["AWS", "Azure", "Azure DevOps"]);
const terminalLabels = new Set(["Agentic workflows", "Agentic Workflows", "Codex", "Editor tooling", "Runtime"]);
---

<li class:list={["pill", "tech-pill", { "tech-pill--icon-only": iconOnly }]} title={iconOnly ? label : undefined}>
  {icon ? (
    <svg class="tech-pill__icon" viewBox={iconViewBox} aria-hidden="true">
      {"body" in icon ? <Fragment set:html={icon.body} /> : <path d={icon.path}></path>}
    </svg>
  ) : cloudLabels.has(label) ? (
    <svg class="tech-pill__icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M7.5 18a4.5 4.5 0 0 1-.55-8.97A6 6 0 0 1 18.6 10.4 3.8 3.8 0 0 1 18.2 18H7.5Z"></path>
    </svg>
  ) : terminalLabels.has(label) ? (
    <svg class="tech-pill__icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="m5 7 5 5-5 5 1.6 1.6 6.6-6.6-6.6-6.6L5 7Zm8 10v2h7v-2h-7Z"></path>
    </svg>
  ) : label === "Playwright" ? (
    <svg class="tech-pill__icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M3.3 5.5c2.4 0 4.3-.7 5.7-1.6v7.3c0 4.3-2.1 7.3-5.7 8.9C1.2 17.8.2 14.8.1 11.2V4c.9.8 2 1.5 3.2 1.5Zm2.9 6.1c-.7 0-1.2.5-1.2 1.2S5.5 14 6.2 14s1.2-.5 1.2-1.2-.5-1.2-1.2-1.2Zm-3.7 0c-.7 0-1.2.5-1.2 1.2S1.8 14 2.5 14s1.2-.5 1.2-1.2-.5-1.2-1.2-1.2Zm.1 4.1c.9 1.1 2.3 1.1 3.2 0H2.6ZM15 3.9c1.4.9 3.3 1.6 5.7 1.6 1.2 0 2.3-.7 3.2-1.5v7.2c-.1 3.6-1.1 6.6-3.2 8.9-3.6-1.6-5.7-4.6-5.7-8.9V3.9Zm2.8 7.7c-.7 0-1.2.5-1.2 1.2s.5 1.2 1.2 1.2 1.2-.5 1.2-1.2-.5-1.2-1.2-1.2Zm3.7 0c-.7 0-1.2.5-1.2 1.2s.5 1.2 1.2 1.2 1.2-.5 1.2-1.2-.5-1.2-1.2-1.2Zm-3.3 4.1c.9 1.1 2.3 1.1 3.2 0h-3.2Z"></path>
    </svg>
  ) : (
    <svg class="tech-pill__icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="m8.6 6-6 6 6 6 1.6-1.7L5.9 12l4.3-4.3L8.6 6Zm6.8 0-1.6 1.7 4.3 4.3-4.3 4.3 1.6 1.7 6-6-6-6Z"></path>
    </svg>
  )}
  <span class:list={{ "sr-only": iconOnly }}>{label}</span>
</li>
