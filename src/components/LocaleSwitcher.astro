---
import { buildPath, localeNames, locales } from "../lib/i18n";
import type { Locale, Labels } from "../lib/types";

interface Props {
  locale: Locale;
  pathSuffix?: string;
  basePath: string;
  labels: Labels;
  /** Locales in which the current page exists; others are not linked. */
  available?: Locale[];
}

const { locale, pathSuffix = "/", basePath, labels, available = locales } = Astro.props;
---

<nav class="locale-links" aria-label={labels.localeLabel}>
  {locales.filter((value) => available.includes(value)).map((value) => (
    <a
      href={buildPath(basePath, value, pathSuffix)}
      class:list={{ "control-group__item": true, "is-active": value === locale }}
      data-locale-link
      data-locale={value}
      lang={value}
      hreflang={value}
      aria-label={`${value.toUpperCase()} – ${localeNames[value]}`}
      aria-current={value === locale ? "page" : undefined}
    >
      {value.toUpperCase()}
    </a>
  ))}
</nav>

<script>
  // Remember an explicit choice; it only informs the dismissible language suggestion, never an automatic redirect.
  for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-locale-link]")) {
    link.addEventListener("click", () => {
      try { localStorage.setItem("preferred-locale", link.dataset.locale ?? ""); } catch {}
    });
  }
</script>
