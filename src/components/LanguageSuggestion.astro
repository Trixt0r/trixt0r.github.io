---
import { getContent } from "../lib/content";
import { localeNames, locales } from "../lib/i18n";
import { localePath } from "../lib/seo";
import type { Locale } from "../lib/types";

interface Props {
  current: Locale;
  pathSuffix: string;
  /** Locales in which this exact page exists; only these can be suggested. */
  available: Locale[];
}

// A dismissible hint, rendered by script only. Language URLs always show their own language; the hint
// never redirects, and the same navigation stays available as plain links in the language switcher.
const { current, pathSuffix, available } = Astro.props;
const targets = Object.fromEntries(
  available
    .filter((locale) => locale !== current)
    .map((locale) => [locale, { href: localePath(locale, pathSuffix), name: localeNames[locale], ...getContent(locale).ui.suggestion }])
);
---

<aside class="language-suggestion" data-language-suggestion data-current={current} data-supported={locales.join(",")} data-targets={JSON.stringify(targets)} hidden>
  <p data-message></p>
  <a data-action class="language-suggestion__action"></a>
  <button type="button" data-dismiss class="language-suggestion__dismiss"><span aria-hidden="true">×</span><span class="sr-only" data-dismiss-label></span></button>
</aside>

<style is:global>
  .language-suggestion { position: fixed; z-index: 40; right: 16px; bottom: 16px; left: 16px; max-width: 460px; margin-left: auto; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; padding: 12px 14px; border: 1px solid var(--p-border, #d8d1c4); border-radius: 8px; background: var(--p-surface, #fffcf5); color: var(--p-text, #17212b); box-shadow: 0 8px 28px rgba(0, 0, 0, .16); font-size: 14px; line-height: 1.4; }
  .language-suggestion[hidden] { display: none; }
  .language-suggestion p { flex: 1 1 200px; margin: 0; }
  .language-suggestion__action { font-weight: 650; color: var(--p-accent, #176943); text-decoration: underline; text-underline-offset: 3px; }
  .language-suggestion__dismiss { min-width: 32px; min-height: 32px; border: 0; border-radius: 4px; background: transparent; color: var(--p-muted, #526170); font-size: 20px; line-height: 1; cursor: pointer; }
  .language-suggestion a:focus-visible, .language-suggestion button:focus-visible { outline: 2px solid var(--p-accent, #176943); outline-offset: 3px; }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-language-suggestion]");
  if (root) {
    const supported = (root.dataset.supported ?? "").split(",");
    const targets = JSON.parse(root.dataset.targets ?? "{}") as Record<string, { href: string; name: string; message: string; action: string; dismiss: string }>;
    const read = (key: string) => { try { return localStorage.getItem(key); } catch { return null; } };
    // An explicit earlier choice wins; otherwise the first browser language this site is available in.
    const saved = read("preferred-locale");
    const browser = (navigator.languages?.length ? navigator.languages : [navigator.language ?? ""])
      .map((tag) => String(tag).toLowerCase().split("-")[0])
      .find((code) => supported.includes(code));
    const candidate = saved && supported.includes(saved) ? saved : browser;
    const target = candidate && candidate !== root.dataset.current ? targets[candidate] : undefined;
    if (candidate && target && read("language-suggestion-dismissed") !== candidate) {
      root.lang = candidate;
      root.querySelector("[data-message]")!.textContent = target.message;
      const action = root.querySelector<HTMLAnchorElement>("[data-action]")!;
      action.href = target.href;
      action.hreflang = candidate;
      action.textContent = target.action;
      root.querySelector("[data-dismiss-label]")!.textContent = target.dismiss;
      root.setAttribute("aria-label", target.name);
      root.hidden = false;
      action.addEventListener("click", () => { try { localStorage.setItem("preferred-locale", candidate); } catch {} });
      root.querySelector("[data-dismiss]")!.addEventListener("click", () => {
        try { localStorage.setItem("language-suggestion-dismissed", candidate); } catch {}
        root.hidden = true;
      });
    }
  }
</script>
