---
import "../styles/site.css";

import type { LocaleContent, Locale } from "../lib/types";
import { locales } from "../lib/i18n";
import { absoluteUrl, alternatesFor, assetUrl, homeSuffix, localePath } from "../lib/seo";

interface Props {
  locale: Locale;
  content: LocaleContent;
  /** Page-specific title and description; the homepage falls back to the shared SEO content. */
  title?: string;
  description?: string;
  /** Route suffix without locale prefix, e.g. "/" or "/projects/ecsts/". */
  pathSuffix?: string;
  /** Locales in which this exact page exists. Only these get hreflang annotations. */
  availableLocales?: Locale[];
  structuredData?: object;
  noindex?: boolean;
  /** Root URL only: send visitors to /ru/ or /en/ based on browser language (German stays here). */
  detectLanguage?: boolean;
}

const {
  locale,
  content,
  title = content.seo.title,
  description = content.seo.description,
  pathSuffix = homeSuffix,
  availableLocales = locales,
  structuredData,
  noindex = false,
  detectLanguage = false
} = Astro.props;
const redirectTargets = { ru: localePath("ru"), en: localePath("en") };
const assetPath = (path: string) => `${import.meta.env.BASE_URL}${path}`;
const siteName = `${content.profile.name} Portfolio`;
const localeCodes: Record<Locale, string> = {
  de: "de_CH",
  en: "en_US",
  ru: "ru_RU"
};
const alternates = alternatesFor(pathSuffix, availableLocales);
const canonical = absoluteUrl(locale, pathSuffix);
const socialImage = assetUrl("og-image.png");
const socialImageAlt = `${content.profile.name} – ${content.summary.currentRoleLabel}, ${content.profile.location}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        let saved;
        try { saved = localStorage.getItem("preferred-theme"); } catch {}
        const theme = saved === "light" || saved === "dark"
          ? saved
          : (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    {detectLanguage && <script is:inline define:vars={{ targets: redirectTargets }}>
      (() => {
        try {
          // Skip bots and visitors who navigated here from this site (e.g. clicked "DE").
          if (/bot|crawl|spider|slurp|lighthouse/i.test(navigator.userAgent)) return;
          if (document.referrer && new URL(document.referrer).origin === location.origin) return;
          let saved;
          try { saved = localStorage.getItem("preferred-locale"); } catch {}
          let locale = saved === "de" || saved === "en" || saved === "ru" ? saved : null;
          if (!locale) {
            const langs = (navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ""]).map((l) => String(l).toLowerCase());
            const match = langs.find((l) => l.startsWith("de") || l.startsWith("ru"));
            locale = match ? (match.startsWith("ru") ? "ru" : "de") : "en";
          }
          if (locale !== "de") location.replace(targets[locale]);
        } catch {}
      })();
    </script>}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={content.profile.name} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" content="#f6f3eb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    {alternates.entries.map((entry) => (
      <link rel="alternate" hreflang={entry.locale} href={entry.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternates.xDefault} />
    <link rel="icon" href={assetPath("favicon.svg")} type="image/svg+xml" />
    <link rel="alternate icon" href={assetPath("favicon.ico")} sizes="any" />
    <link rel="apple-touch-icon" href={assetPath("apple-touch-icon.png")} />
    <link rel="manifest" href={assetPath("site.webmanifest")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:locale" content={localeCodes[locale]} />
    {alternates.entries.filter((entry) => entry.locale !== locale).map((entry) => (
      <meta property="og:locale:alternate" content={localeCodes[entry.locale]} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>}
  </head>
  <body>
    <slot />
  </body>
</html>
