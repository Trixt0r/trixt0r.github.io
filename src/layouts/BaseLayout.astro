---
import "../styles/site.css";

import type { LocaleContent, Locale } from "../lib/types";
import LanguageSuggestion from "../components/LanguageSuggestion.astro";
import { locales, ogLocales } from "../lib/i18n";
import { absoluteUrl, alternatesFor, assetUrl, homeSuffix } from "../lib/seo";

interface Props {
  locale: Locale;
  content: LocaleContent;
  /** Page-specific title and description; the homepage falls back to the shared SEO content. */
  title?: string;
  description?: string;
  /** Route suffix without locale prefix, e.g. "/" or "/projects/ecsts/". */
  pathSuffix?: string;
  /** Locales in which this exact page exists. Only these get hreflang annotations. */
  availableLocales?: Locale[];
  structuredData?: object;
  noindex?: boolean;
}

const {
  locale,
  content,
  title = content.seo.title,
  description = content.seo.description,
  pathSuffix = homeSuffix,
  availableLocales = locales,
  structuredData,
  noindex = false
} = Astro.props;
const assetPath = (path: string) => `${import.meta.env.BASE_URL}${path}`;
const siteName = `${content.profile.name} Portfolio`;
const alternates = alternatesFor(pathSuffix, availableLocales);
const canonical = absoluteUrl(locale, pathSuffix);
const socialImage = assetUrl("og-image.png");
const socialImageAlt = `${content.profile.name} – ${content.summary.currentRoleLabel}, ${content.profile.location}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        let saved;
        try { saved = localStorage.getItem("preferred-theme"); } catch {}
        const theme = saved === "light" || saved === "dark"
          ? saved
          : (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={content.profile.name} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" content="#f6f3eb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    {alternates.entries.map((entry) => (
      <link rel="alternate" hreflang={entry.locale} href={entry.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternates.xDefault} />
    <link rel="icon" href={assetPath("favicon.svg")} type="image/svg+xml" />
    <link rel="alternate icon" href={assetPath("favicon.ico")} sizes="any" />
    <link rel="apple-touch-icon" href={assetPath("apple-touch-icon.png")} />
    <link rel="manifest" href={assetPath("site.webmanifest")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:locale" content={ogLocales[locale]} />
    {alternates.entries.filter((entry) => entry.locale !== locale).map((entry) => (
      <meta property="og:locale:alternate" content={ogLocales[entry.locale]} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>}
  </head>
  <body>
    <slot />
    <LanguageSuggestion current={locale} pathSuffix={pathSuffix} available={availableLocales} />
  </body>
</html>
