---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LocaleSwitcher from "../../components/LocaleSwitcher.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
import TechPill from "../../components/TechPill.astro";
import SkillCategoryIcon from "../../components/SkillCategoryIcon.astro";
import SectionTopButton from "../../components/SectionTopButton.astro";
import "../../styles/portfolio.css";
import { getContent } from "../../lib/content";
import { locales, formatPeriod } from "../../lib/i18n";
import type { Locale } from "../../lib/types";

export function getStaticPaths() { return locales.map((lang) => ({ params: { lang } })); }
const locale = (Astro.props.locale ?? Astro.params.lang) as Locale;
const content = getContent(locale);
const { profile, labels } = content;
const basePath = import.meta.env.BASE_URL;
const backToSection = { en: "Back to start of section", de: "Zum Anfang des Abschnitts", ru: "К началу раздела" }[locale];
const careerNav = { en: "Career", de: "Werdegang", ru: "Карьера" }[locale];
const copy = {
  en: { nav: "Main navigation", skip: "Skip to content", experience: "Experience", projects: "Projects", skills: "Skills", about: "About", contact: "Contact", overview: "Professional overview", focus: "Areas of focus", career: "Career", careerNote: "Roles & selected work", projectNote: "Selected open source", allProjects: "More on GitHub", details: "Responsibilities & technologies", repository: "View repository", location: "Based in", languages: "Languages", education: "Education", connect: "Get in touch", cv: "View résumé", profile: "Profile", present: "Present" },
  de: { nav: "Hauptnavigation", skip: "Zum Inhalt springen", experience: "Erfahrung", projects: "Projekte", skills: "Kenntnisse", about: "Über mich", contact: "Kontakt", overview: "Berufliches Profil", focus: "Schwerpunkte", career: "Beruflicher Werdegang", careerNote: "Positionen & Aufgaben", projectNote: "Ausgewählte Open-Source-Projekte", allProjects: "Mehr auf GitHub", details: "Aufgaben & Technologien", repository: "Repository ansehen", location: "Standort", languages: "Sprachen", education: "Ausbildung", connect: "Kontakt aufnehmen", cv: "Lebenslauf ansehen", profile: "Profil", present: "Heute" },
  ru: { nav: "Основная навигация", skip: "К содержанию", experience: "Опыт", projects: "Проекты", skills: "Навыки", about: "Обо мне", contact: "Контакт", overview: "Профессиональный профиль", focus: "Направления работы", career: "Опыт работы", careerNote: "Должности и задачи", projectNote: "Избранные open-source проекты", allProjects: "Больше на GitHub", details: "Обязанности и технологии", repository: "Открыть репозиторий", location: "Местоположение", languages: "Языки", education: "Образование", connect: "Связаться", cv: "Посмотреть резюме", profile: "Профиль", present: "Настоящее время" }
}[locale];
// Overlapping roles are deliberately retained; sort by the beginning of each role.
const experience = [...content.experience].sort((a, b) => b.start.localeCompare(a.start));
const currentExperience = experience.find((item) => item.end === null);
---
<BaseLayout locale={locale} content={content} pathSuffix="/">
  <div class="portfolio" id="top">
    <a class="portfolio-skip" href="#main" target="_self">{copy.skip}</a>
    <header class="portfolio-header">
      <div class="portfolio-container header-inner">
        <a class="portfolio-brand" href="#top" target="_self"><span class="brand-mark" aria-hidden="true">hr<span>.</span></span><span>{profile.name}</span></a>
        <nav class="portfolio-nav" aria-label={copy.nav}>
          <a class="nav-desktop-only" href="#about" target="_self">{copy.about} / {copy.skills}</a>
          <a class="nav-desktop-only" href="#experience" target="_self">{careerNav} / {copy.projects}</a>
          <a class="nav-mobile-only" href="#about" target="_self">{copy.about}</a>
          <a class="nav-mobile-only" href="#skills" target="_self">{copy.skills}</a>
          <a class="nav-mobile-only" href="#experience" target="_self">{careerNav}</a>
          <a class="nav-mobile-only" href="#projects" target="_self">{copy.projects}</a>
        </nav>
        <div class="header-controls"><LocaleSwitcher locale={locale} labels={labels} basePath={basePath} /><ThemeToggle labels={labels} /></div>
      </div>
    </header>
    <main id="main" class="portfolio-container">
      <section class="intro" aria-labelledby="intro-title">
        <div class="intro-main">
          <h1 id="intro-title">{profile.name}<span class="heading-dot">.</span></h1>
          <h2 class="intro-title">{profile.title}<span class="intro-location"> · {profile.location}</span></h2>
          <div class="profile-links" id="contact">
            <a href={content.links.github} title="GitHub" aria-label="GitHub"><svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.59 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.66-.22.66-.49V19.8c-2.77.62-3.36-1.21-3.36-1.21-.45-1.2-1.11-1.52-1.11-1.52-.91-.64.07-.62.07-.62 1.01.07 1.54 1.06 1.54 1.06.89 1.56 2.34 1.11 2.91.85.09-.67.35-1.12.63-1.38-2.21-.26-4.53-1.13-4.53-5.05 0-1.11.39-2.02 1.03-2.73-.1-.26-.45-1.3.1-2.7 0 0 .84-.27 2.75 1.04a9.3 9.3 0 0 1 5 0c1.91-1.31 2.75-1.04 2.75-1.04.55 1.4.2 2.44.1 2.7.64.71 1.03 1.62 1.03 2.73 0 3.93-2.32 4.78-4.54 5.04.36.32.68.93.68 1.88v2.64c0 .27.16.59.69.49A10.24 10.24 0 0 0 22 12.25C22 6.59 17.52 2 12 2Z"></path></svg></a>
            <a href={content.links.linkedin} title="LinkedIn" aria-label="LinkedIn"><svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14ZM8.34 17v-6.33H6.26V17h2.08ZM7.3 9.8a1.21 1.21 0 1 0 0-2.42 1.21 1.21 0 0 0 0 2.42ZM17.74 17v-3.46c0-1.85-.99-3.1-2.9-3.1-1.08 0-1.7.61-1.8 1.03v-.8h-2.07V17h2.08v-3.54c0-.27 0-.4.1-.52.12-.33.46-.67 1-.67.69 0 1.04.47 1.04 1.31V17h2.55Z"></path></svg></a>
            <a href={`mailto:${profile.email}`} title={labels.emailLabel} aria-label={labels.emailLabel}><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m4 7 8 6 8-6"></path></svg></a>
            <a href={`tel:${profile.phone.replace(/\s+/g, "")}`} title={labels.phoneLabel} aria-label={labels.phoneLabel}><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7l.5 2.8a2 2 0 0 1-.6 1.8L7.7 9.6a16 16 0 0 0 6.7 6.7l1.3-1.3a2 2 0 0 1 1.8-.6l2.8.5a2 2 0 0 1 1.7 2Z"></path></svg></a>
          </div>
        </div>
        <aside class="intro-aside" aria-label={copy.profile}>
          <img class="profile-avatar" src={`${basePath}profile-avatar.jpg`} alt={profile.name} width="96" height="96" />
          <dl>
            <div><dt title={copy.location} aria-label={copy.location}><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg></dt><dd>{profile.location}</dd></div>
            <div><dt title={labels.currentRole} aria-label={labels.currentRole}><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="14" rx="2"></rect><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18"></path></svg></dt><dd>{content.summary.currentRoleLabel}{currentExperience && ` · ${currentExperience.company}`}</dd></div>
            <div><dt title={copy.focus} aria-label={copy.focus}><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="5"></circle><circle cx="12" cy="12" r="1"></circle></svg></dt><dd>{content.summary.focusAreas.slice(0, 2).join(" · ")}</dd></div>
          </dl>
        </aside>
      </section>

      <div class="portfolio-columns about-columns" id="about">
        <section class="content-section about-section" aria-labelledby="about-title">
          <div class="section-heading"><div><p class="section-kicker"><span>01</span> / {copy.profile}</p><h2 id="about-title">{copy.about}</h2></div><SectionTopButton label={backToSection} /></div>
          <div class="about-body"><p>{content.summary.blurb}</p><p>{content.hero.subheadline}</p>{content.summary.about.map((paragraph) => <p>{paragraph}</p>)}</div>
        </section>
        <section class="content-section skills-section" id="skills"><div class="section-heading"><div><p class="section-kicker"><span>02</span> / {labels.techStack}</p><h2>{copy.skills}</h2></div><SectionTopButton label={backToSection} /></div><div class="skill-rows">{content.skills.groups.map((group) => <div class="skill-row"><h3 title={group.label}><SkillCategoryIcon category={group.id} /><span class="sr-only">{group.label}</span></h3><p>{group.items.join(" · ")}</p></div>)}<div class="skill-row"><h3 title={copy.languages}><SkillCategoryIcon category="languages" /><span class="sr-only">{copy.languages}</span></h3><p>{content.languages.items.map((item) => `${item.name} (${item.level})`).join(" · ")}</p></div></div></section>
      </div>

      <div class="portfolio-columns">
        <section class="content-section experience-section" id="experience">
          <span id="history" class="anchor-alias" aria-hidden="true"></span>
          <div class="section-heading"><div><p class="section-kicker"><span>03</span> / {copy.careerNote}</p><h2>{copy.career}</h2></div><SectionTopButton label={backToSection} /></div>
          <ol class="career-list">
            {experience.map((item) => <li class:list={["career-item", { "career-item--current": item.end === null }]}>
              <div class="career-date">{formatPeriod(item.start, item.end, locale, copy.present)}</div>
              <article class="career-content"><h3>{item.role}</h3><p class="career-company">{item.company} <span>· {item.location}</span></p><p class="career-summary">{item.summary}</p>
                <ul class="tech-list" aria-label={labels.techStack}>{item.tech.slice(0, 5).map((tech) => <TechPill label={tech} iconOnly />)}</ul>
                <details class="career-details"><summary>{copy.details}</summary><ul>{item.highlights.map((highlight) => <li>{highlight}</li>)}</ul><p><strong>{labels.techStack}:</strong> {item.tech.join(" · ")}</p></details>
              </article>
            </li>)}
            {content.education.items.map((education) => <li class="career-item">
              <div class="career-date">{education.period}</div>
              <article class="career-content"><h3>{education.degree}</h3><p class="career-company">{education.institution} <span>· {education.location}</span></p><p class="career-summary">{education.summary}</p></article>
            </li>)}
          </ol>
        </section>

        <div class="portfolio-side">
          <section class="content-section projects-section" id="projects">
            <div class="section-heading"><div><p class="section-kicker"><span>04</span> / {labels.sectionProjects}</p><h2>{copy.projects}</h2></div><SectionTopButton label={backToSection} /></div>
            <div class="project-list">{content.projects.map((project) => <article class="project-card-compact"><a class="project-card-link" href={project.url}><div class="project-top"><h3>{project.name}<span class="sr-only"> — {copy.repository}</span></h3><span aria-hidden="true">↗</span></div><p>{project.summary}</p><div class="project-bottom"><ul class="tech-list" aria-label={labels.techStack}>{project.tech.map((tech) => <TechPill label={tech} iconOnly />)}</ul><span class="project-period">{project.period}</span></div></a></article>)}<article class="project-card-compact"><a class="project-card-link" href={content.links.github}><div class="project-top"><h3>{copy.allProjects}</h3><span aria-hidden="true">↗</span></div></a></article></div>
          </section>
        </div>
      </div>

      <div class="end-spacer" aria-hidden="true"></div>
    </main>
    <footer class="portfolio-footer"><div class="portfolio-container footer-inner"><span>© {new Date().getFullYear()} {profile.name}</span><a href="#top" target="_self">↑ {copy.profile}</a></div></footer>
  </div>
</BaseLayout>

<script>
  const header = document.querySelector<HTMLElement>(".portfolio-header");
  const portfolio = document.querySelector<HTMLElement>(".portfolio");
  if (header && portfolio) {
    const headings = portfolio.querySelectorAll<HTMLElement>(".content-section > .section-heading");
    const navLinks = portfolio.querySelectorAll<HTMLAnchorElement>(".portfolio-nav a[href^='#']");
    const getDestination = (target: HTMLElement) => target.matches(".content-section") ? target : target.querySelector<HTMLElement>(".content-section");
    let frame = 0;
    const updateStickyState = () => {
      frame = 0;
      const headerBottom = header.getBoundingClientRect().bottom;
      header.classList.toggle("is-stuck", window.scrollY > 0);
      for (const heading of headings) {
        const section = heading.closest<HTMLElement>(".content-section");
        if (!section) continue;
        const sectionBounds = section.getBoundingClientRect();
        const bounds = heading.getBoundingClientRect();
        const naturalTop = sectionBounds.top + parseFloat(getComputedStyle(section).paddingTop);
        heading.classList.toggle("is-stuck", naturalTop <= headerBottom + 1);
        heading.classList.toggle("is-pinned", Math.abs(bounds.top - headerBottom) <= 1 && sectionBounds.bottom > bounds.bottom + 1);
      }
      const destinations: { link: HTMLAnchorElement; start: number; end: number }[] = [];
      for (const link of navLinks) {
        if (!link.getClientRects().length) continue;
        const target = document.getElementById(link.hash.slice(1));
        if (!target) continue;
        const section = getDestination(target);
        const destination = section ?? target;
        const bounds = destination.getBoundingClientRect();
        const styles = getComputedStyle(destination);
        const heading = section?.querySelector<HTMLElement>(":scope > .section-heading");
        const start = bounds.top + (section ? parseFloat(styles.paddingTop) : 0);
        const end = heading
          ? bounds.bottom - parseFloat(styles.paddingBottom) - parseFloat(getComputedStyle(heading).marginBottom) - heading.offsetHeight
          : bounds.bottom;
        destinations.push({ link, start, end });
      }
      let currentIndex = -1;
      for (let i = 0; i < destinations.length; i++) {
        if (destinations[i].start <= headerBottom + 6) currentIndex = i;
      }
      while (currentIndex >= 0 && currentIndex < destinations.length && destinations[currentIndex].end <= headerBottom + 1) currentIndex++;
      const current = destinations[currentIndex]?.link ?? null;
      for (const link of navLinks) {
        const active = link === current;
        link.classList.toggle("is-current", active);
        if (active) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      }
    };
    const scheduleStickyState = () => {
      if (!frame) frame = requestAnimationFrame(updateStickyState);
    };
    const updateHeaderOffset = () => {
      portfolio.style.setProperty("--header-offset", `${header.offsetHeight}px`);
      scheduleStickyState();
    };
    updateHeaderOffset();
    new ResizeObserver(updateHeaderOffset).observe(header);
    const finalSection = portfolio.querySelector<HTMLElement>("#projects");
    const endSpacer = portfolio.querySelector<HTMLElement>(".end-spacer");
    const footer = portfolio.querySelector<HTMLElement>(".portfolio-footer");
    if (finalSection && endSpacer && footer) {
      const updateEndSpace = () => {
        const headingTop = finalSection.getBoundingClientRect().top + parseFloat(getComputedStyle(finalSection).paddingTop);
        const remainingContent = endSpacer.getBoundingClientRect().top - headingTop + footer.offsetHeight;
        const space = Math.max(0, window.innerHeight - header.offsetHeight - remainingContent + 16);
        portfolio.style.setProperty("--end-space", `${space}px`);
      };
      updateEndSpace();
      const endSpaceObserver = new ResizeObserver(updateEndSpace);
      endSpaceObserver.observe(finalSection);
      endSpaceObserver.observe(header);
      endSpaceObserver.observe(footer);
      window.addEventListener("resize", updateEndSpace);
    }
    window.addEventListener("scroll", scheduleStickyState, { passive: true });
    window.addEventListener("resize", scheduleStickyState);
    const scrollToSection = (target: HTMLElement) => {
      const section = getDestination(target);
      const destination = section ?? target;
      const padding = section ? parseFloat(getComputedStyle(section).paddingTop) : 0;
      const top = window.scrollY + destination.getBoundingClientRect().top + padding - header.offsetHeight - 4;
      window.scrollTo({
        top: Math.max(0, top),
        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth"
      });
    };
    for (const button of portfolio.querySelectorAll<HTMLButtonElement>(".section-top-button")) {
      button.addEventListener("click", () => {
        const section = button.closest<HTMLElement>(".content-section");
        if (section) scrollToSection(section);
      });
    }
    for (const link of navLinks) {
      link.addEventListener("click", (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const target = document.getElementById(link.hash.slice(1));
        if (!target) return;
        event.preventDefault();
        history.pushState(null, "", link.hash);
        scrollToSection(target);
      });
    }
  }
</script>
