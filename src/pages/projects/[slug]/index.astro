---
import ProjectPageView from "../../../components/ProjectPageView.astro";
import { getContent } from "../../../lib/content";

export function getStaticPaths() {
  return getContent("de").projectPages.map((page) => ({ params: { slug: page.id } }));
}

const { slug } = Astro.params;
---

<ProjectPageView locale="de" id={slug!} />
